// Conway's Life displayed on a 4tronix CUBE:BIT LED cube driven
// by a Raspberry Pi Pico.

import("conway");
import("cube_bit");
import("display");

cube_bit_init();

while (true) {

    display_on_surface(surface_world);
    surface_world = next_generation(surface_world, surface_neighbour_of);
}
    